Enum "address_addresstype_enum" {
  "BILLING"
  "SHIPPING"
  "OTHER"
}

Enum "address_type_enum" {
  "shipping"
  "billing"
}

Enum "banner_position_enum" {
  "top"
  "middle"
  "bottom"
  "sidebar"
}

Enum "banner_type_enum" {
  "main"
  "promotional"
  "featured"
}

Enum "coupon_discounttype_enum" {
  "percentage"
  "fixed"
}

Enum "order_orderstatus_enum" {
  "pending"
  "processing"
  "shipped"
  "delivered"
  "cancelled"
}

Enum "order_paymentstatus_enum" {
  "pending"
  "completed"
  "partial"
  "paid"
  "failed"
  "refunded"
}

Enum "order_status_track_status_enum" {
  "pending"
  "processing"
  "shipped"
  "delivered"
  "cancelled"
}

Enum "product_discounttype_enum" {
  "percentage"
  "fixed"
}

Table "user" {
  "id" int4 [pk, not null, increment]
  "name" varchar [not null]
  "email" varchar [unique, not null]
  "password" varchar
  "isVerified" bool [not null, default: false]
  "lastLoginAt" timestamp
  "createdAt" timestamp [not null, default: `now()`]
  "updatedAt" timestamp [not null, default: `now()`]
  "mobileNumber" varchar
  "otp" varchar
  "otpExpiresAt" timestamp
  "profilePhotoId" int4
  "roleId" int4 [default: 3]
  "cartId" int4 [unique]
}

Table "category" {
  "id" int4 [pk, not null, increment]
  "name" varchar [unique, not null]
  "slug" varchar [unique]
  "description" varchar
  "isActive" bool [not null, default: true]
  "createdAt" timestamp [not null, default: `now()`]
  "updatedAt" timestamp [not null, default: `now()`]
  "attachmentId" int4
  "parentId" int4
  "createdBy" int4
  "updatedBy" int4
  "is_main_menu" bool [not null, default: false]
}

Table "product" {
  "id" int4 [pk, not null, increment]
  "name" varchar [not null]
  "slug" varchar [unique]
  "description" text
  "productSku" varchar(50) [unique]
  "isActive" bool [not null, default: true]
  "isFeatured" bool [not null, default: false]
  "createdAt" timestamp [not null, default: `now()`]
  "updatedAt" timestamp [not null, default: `now()`]
  "attachmentId" int4
  "categoryId" int4
  "brandId" int4
  "unitId" int4
  "supplierId" int4
  "sellingPrice" int4
  "createdBy" int4
  "updatedBy" int4
  "purchasePrice" int4
  "stock" int4 [not null, default: 0]
  "totalValueBySalePrice" numeric(12,2) [not null, default: '0']
  "totalValueByPurchasePrice" numeric(12,2) [not null, default: '0']
  "discountType" product_discounttype_enum
  "discountValue" numeric(6,2)
  "discountStartDate" timestamp
  "discountEndDate" timestamp
  "weight" numeric(10,2) [default: '0']
  "galleryId" int4 [unique]
  "saleCount" int4 [not null, default: 0]
}

Table "brand" {
  "id" int4 [pk, not null, increment]
  "name" varchar [unique, not null]
  "slug" varchar [unique]
  "description" varchar
  "website" varchar
  "isActive" bool [not null, default: true]
  "createdAt" timestamp [not null, default: `now()`]
  "updatedAt" timestamp [not null, default: `now()`]
  "attachmentId" int4
  "createdby" int4
  "updatedby" int4
}

Table "attachment" {
  "id" int4 [pk, not null, increment]
  "fileName" varchar [not null]
  "originalName" varchar [not null]
  "mimeType" varchar [not null]
  "size" int4 [not null]
  "url" varchar [not null]
  "key" varchar [not null]
  "createdAt" timestamp [not null, default: `now()`]
  "updatedAt" timestamp [not null, default: `now()`]
  "gallery_id" int4
}

Table "menu" {
  "id" int4 [pk, not null, increment]
  "name" varchar(100) [not null]
  "parentId" int4
  "icon" varchar(50)
  "url" varchar(255)
  "order" int4 [not null, default: 0]
  "is_main_menu" bool [not null, default: false]
  "is_active" bool [not null, default: true]
  "is_admin_menu" bool [not null, default: false]
  "createdAt" timestamp [not null, default: `now()`]
  "updatedAt" timestamp [not null, default: `now()`]

  Indexes {
    parentId [type: btree, name: "IDX_23ac1b81a7bfb85b14e86bd23a"]
  }
}

Table "unit" {
  "id" int4 [pk, not null, increment]
  "name" varchar(50) [unique, not null]
  "isActive" bool [not null, default: true]
  "created_date" timestamp [not null, default: `now()`]
  "updated_date" timestamp [not null, default: `now()`]
  "createdby" int4
  "updatedby" int4
}

Table "role" {
  "id" int4 [pk, not null, increment]
  "rolename" varchar(100) [unique, not null]
  "description" text
  "isActive" bool [not null, default: true]
  "createdBy" int4
  "updatedBy" int4
  "createdAt" timestamp [not null, default: `now()`]
  "updatedAt" timestamp [not null, default: `now()`]
}

Table "menu_permission" {
  "id" int4 [pk, not null, increment]
  "roleId" int4 [not null]
  "menuId" int4 [not null]
  "canView" bool [not null, default: false]
  "createdAt" timestamp [not null, default: `now()`]
  "updatedAt" timestamp [not null, default: `now()`]
}

Table "supplier" {
  "id" int4 [pk, not null, increment]
  "name" varchar [not null]
  "email" varchar
  "phone" varchar
  "address" varchar
  "isActive" bool [not null, default: true]
  "createdAt" timestamp [not null, default: `now()`]
  "updatedAt" timestamp [not null, default: `now()`]
  "createdBy" int4
  "updatedBy" int4
  "attachmentId" int4
}

Table "purchase" {
  "id" int4 [pk, not null, increment]
  "status" varchar [not null, default: 'pending']
  "notes" text
  "createdAt" timestamp [not null, default: `now()`]
  "updatedAt" timestamp [not null, default: `now()`]
  "supplierId" int4
  "createdBy" int4
  "updatedBy" int4
  "purchaseNumber" varchar [unique, not null]
  "totalValue" numeric(10,2) [not null, note: 'Total value of the purchase (sum of all items total)']
  "paymentStatus" varchar [not null, default: 'due']
  "amountPaid" numeric(10,2) [not null, default: '0']
  "purchase_date" timestamp [not null, default: `now()`]
}

Table "payment" {
  "id" int4 [pk, not null, increment]
  "paymentNumber" varchar [unique, not null]
  "amount" numeric(10,2) [not null]
  "paymentDate" date [not null]
  "referenceNumber" varchar
  "notes" text
  "status" varchar [not null, default: 'completed']
  "createdAt" timestamp [not null, default: `now()`]
  "updatedAt" timestamp [not null, default: `now()`]
  "purchaseId" int4
  "createdBy" int4
  "updatedBy" int4
  "paymentMethodId" int4
}

Table "payment_method" {
  "id" int4 [pk, not null, increment]
  "code" varchar [unique, not null]
  "name" varchar [not null]
  "description" text
  "isActive" bool [not null, default: true]
  "createdAt" timestamp [not null, default: `now()`]
  "updatedAt" timestamp [not null, default: `now()`]
  "createdBy" int4
  "updatedBy" int4
}

Table "banner" {
  "id" int4 [pk, not null, increment]
  "title" varchar [not null]
  "description" text
  "targetUrl" varchar
  "position" banner_position_enum [not null, default: 'top']
  "type" banner_type_enum [not null, default: 'main']
  "isActive" bool [not null, default: true]
  "displayOrder" int4 [not null, default: 0]
  "createdAt" timestamp [not null, default: `now()`]
  "updatedAt" timestamp [not null, default: `now()`]
  "imageId" int4
  "createdBy" int4
  "updatedBy" int4
}

Table "purchase_item" {
  "id" int4 [pk, not null, increment]
  "unitPrice" numeric(10,2) [not null]
  "quantity" int4 [not null]

  "purchaseId" int4
  "productId" int4
  "createdBy" int4
  "updatedBy" int4
  "createdAt" timestamp [not null, default: `now()`]
  "updatedAt" timestamp [not null, default: `now()`]
}

Table "address" {
  "id" int4 [pk, not null, increment]
  "address" varchar
  "area" varchar
  "division" varchar
  "city" varchar

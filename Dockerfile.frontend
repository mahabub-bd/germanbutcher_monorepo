# Base stage - minimal Alpine with Node.js only
FROM node:24-alpine AS base

RUN apk add --no-cache libc6-compat
WORKDIR /app

# pnpm via corepack, pinned on purpose: "pnpm@11" floats to the latest 11.x,
# and pnpm 11 is exactly what introduced the lockfile supply-chain pass that
# was costing ~7 min per install. Pinning makes build time reproducible.
RUN corepack enable && corepack prepare pnpm@11.28.11 --activate

FROM base AS deps

# Copy workspace root manifest, lockfile and workspace config
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# The lockfile records an importer for every workspace package,
# so each package.json must be present for a frozen install
COPY apps/frontend/package.json apps/frontend/package.json
COPY apps/backend/package.json apps/backend/package.json

# Cache-mounted pnpm store survives layer invalidation; only frontend deps
# are installed — the backend toolchain is not needed to build the frontend.
#
# No gcc/python3/make layer any more: in the 2026-11-08 build nothing compiled
# from source — sharp@0.34.5, unrs-resolver and @parcel/watcher all installed
# prebuilt linuxmusl-x64 binaries, and bcrypt (the only real native build) is a
# backend-only dep that --filter never installs. That layer cost 99.6s and 302MB
# per cold build. If a dependency ever does need to compile, put back before
# this RUN:
#   USER root
#   RUN apk add --no-cache python3 make g++
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter germanbutcher-frontend...

FROM deps AS builder

# Copy the frontend sources (node_modules/.next are excluded via .dockerignore)
COPY apps/frontend ./apps/frontend

# Set environment for build
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV CI=true

# Build arguments for public environment variables
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_BASE_URL
ARG NEXT_PUBLIC_SOCKET_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_BASE_URL=${NEXT_PUBLIC_BASE_URL}
ENV NEXT_PUBLIC_SOCKET_URL=${NEXT_PUBLIC_SOCKET_URL}

# Build the application. The .next/cache mount keeps the webpack and
# TypeScript incremental caches across builds, but it only pays off when the
# source files and the NEXT_PUBLIC_* values above are unchanged — a changed
# build-arg invalidates the whole webpack cache (that is why the compile step
# still reads 2.7min on some deploys).
RUN --mount=type=cache,target=/app/apps/frontend/.next/cache \
    pnpm --filter germanbutcher-frontend run build

# Production stage - start from clean base (no build tools)
FROM node:24-alpine AS production

ENV NODE_ENV=production
ENV PORT=3002
ENV HOSTNAME=0.0.0.0
ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app

# Build arguments for runtime environment variables
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_BASE_URL
ARG NEXT_PUBLIC_SOCKET_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_BASE_URL=${NEXT_PUBLIC_BASE_URL}
ENV NEXT_PUBLIC_SOCKET_URL=${NEXT_PUBLIC_SOCKET_URL}

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001

COPY --from=builder --chown=nextjs:nodejs /app/apps/frontend/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/frontend/.next/static ./apps/frontend/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/frontend/public ./apps/frontend/public

USER nextjs

EXPOSE 3002

CMD ["node", "apps/frontend/server.js"]
